# Ignore real environment files
.env
.env.*
# Allow example template
!.env.example

# Python
__pycache__/
*.pyc

# Node
node_modules/

# Others
*.log
.vscode/
.idea/
 
# Outputs (runtime)
/reports/
/data/
# Generated backtest/optimizer output. production_params.json is a runtime
# *input* (loaded by app/main.py at startup), so it stays tracked. Git
# cannot re-include a file whose parent dir is excluded, hence the glob.
artifacts/*
!artifacts/production_params.json
optuna.db
trading_summary.csv
portfolio_snapshot.json
explainability_ledger.jsonl
guardrails_ledger.jsonl
orders_api_ledger_*.jsonl

# Virtualenvs
.venv/

# Archives and backups
_prev/
@*/
intradyne_lite/

# Vendored upstream repos, cloned for reference. They are git repos, so a
# bare `git add -A` stages them as stray gitlinks pointing at commits nobody
# can resolve -- which has already happened once.
vendor/
