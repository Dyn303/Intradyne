# Core mode & venue
MODE=paper
EXCHANGE=bitget
LIVE_TRADING_ENABLED=false
USE_TESTNET=true

# API keys (optional for paper; required for live/testnet)
API_KEY=
API_SECRET=
API_PASSPHRASE=

# App
PORT=8000
LOG_DIR=logs
LOG_LEVEL=INFO

# Risk defaults
MAX_POS_PCT=0.015
PER_TRADE_SL_PCT=0.003
TP_PCT=0.002
DD_SOFT=0.03
DD_HARD=0.05
FLASH_CRASH_DROP_1H=0.30
MAX_CONCURRENT_POS=5
KILL_SWITCH_BREACHES=3

# Fees & slippage
MAKER_BPS=2
TAKER_BPS=5
SLIPPAGE_BPS=2

# Symbols: loaded from app/whitelist.json and filtered by exchange at runtime


# --- API service ---------------------------------------------------------
# These govern the FastAPI service (src/intradyne/api). Note that API_KEY
# above is the *broker* credential and is NOT accepted as the HTTP auth key.

# HTTP auth. Enforced automatically when APP_ENV=prod|production; set to 1 to
# enforce it elsewhere. When enforced, X_API_KEY must be set or the app
# refuses to start. Clients send it as the `X-API-Key` header (WebSocket
# clients may instead pass ?api_key=... since browsers cannot set WS headers).
APP_ENV=development
API_AUTH_REQUIRED=0
X_API_KEY=

# CORS. A bare '*' is refused in production: with credentials enabled it means
# "trust every site". Set an explicit comma-separated origin list.
FRONTEND_ORIGINS=*

# Guards POST /admin/halt when set.
ADMIN_SECRET=

# Rate limiting (requests per window, window in seconds).
RATE_LIMIT_REQS=120
RATE_LIMIT_WINDOW=60

# Where the hash-chained explainability ledger is written. Must be a writable
# path; container images mount /app/data read-write and the rest read-only.
EXPLAIN_LEDGER_PATH=explainability_ledger.jsonl
