# Core mode & venue
# Run the trading loop inside the API service. Off by default: the machinery
# is in place but switching it on is a deliberate step.
ENGINE_ENABLED=false
MODE=paper
EXCHANGE=bitget
LIVE_TRADING_ENABLED=false
USE_TESTNET=true

# Broker credentials (optional for paper; required for live/testnet).
# API_KEY / API_SECRET / API_PASSPHRASE are accepted as legacy aliases.
# NOTE: these are the *broker* credentials. The HTTP API key is X_API_KEY,
# further down, and is deliberately unrelated.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# App
PORT=8000
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Tier 2: sizing and per-trade exits (engine RiskManager) ---
MAX_POS_PCT=0.015
PER_TRADE_SL_PCT=0.003
TP_PCT=0.002
MAX_CONCURRENT_POS=5
# Session drawdown, i.e. loss against the equity this run started with.
DD_SOFT=0.03
DD_HARD=0.05

# --- Tier 1: pre-trade veto thresholds (Guardrails.gate_trade) ---
# 30-day peak-to-trough drawdown. A DIFFERENT measurement from DD_SOFT/DD_HARD
# above; both are intentional and are not interchangeable.
DD_WARN_PCT=0.15
DD_HALT_PCT=0.20
VAR_1D_MAX=0.05

# --- Execution style ---
# taker crosses the spread on every order: immediate fills at 5+2bps a side.
# maker posts entries passively at the touch for 2bps and no slippage, at the
# cost of missed fills and adverse selection -- you fill when price comes to
# you, which is when the move is against you. Exits always cross: a passive
# stop is not a stop.
EXECUTION_MODE=taker
MAKER_OFFSET_BPS=0
LIMIT_TTL_S=60

# --- Exposure caps (quote currency; 0 disables) ---
# Bound how much the system can transact, independent of the risk thresholds:
# a strategy looping on a bad signal can place unlimited orders that each pass
# every risk check. An order whose notional cannot be evaluated is refused.
MAX_ORDER_NOTIONAL=0
MAX_SYMBOL_NOTIONAL_24H=0
MAX_DAILY_NOTIONAL=0

# --- Shared by both tiers ---
# One value each; FLASH_CRASH_DROP_1H is accepted as an alias for the first.
FLASH_CRASH_PCT=0.30
KILL_SWITCH_BREACHES=3

# Universe (comma separated, BASE or BASE/QUOTE). Overrides the whitelist
# for the guardrail check.
ALLOWED_SYMBOLS=BTC,ETH,SOL,XRP,ADA,LTC,AVAX,DOT,MATIC,USDT

# Fees & slippage
MAKER_BPS=2
TAKER_BPS=5
SLIPPAGE_BPS=2

# Symbols: loaded from app/whitelist.json and filtered by exchange at runtime


# --- API service ---------------------------------------------------------
# These govern the FastAPI service (src/intradyne/api). Note that API_KEY
# above is the *broker* credential and is NOT accepted as the HTTP auth key.

# HTTP auth. Enforced automatically when APP_ENV=prod|production; set to 1 to
# enforce it elsewhere. When enforced, X_API_KEY must be set or the app
# refuses to start. Clients send it as the `X-API-Key` header (WebSocket
# clients may instead pass ?api_key=... since browsers cannot set WS headers).
APP_ENV=development
API_AUTH_REQUIRED=0
X_API_KEY=

# CORS. A bare '*' is refused in production: with credentials enabled it means
# "trust every site". Set an explicit comma-separated origin list.
FRONTEND_ORIGINS=*

# Guards POST /admin/halt when set.
ADMIN_SECRET=

# Rate limiting (requests per window, window in seconds).
RATE_LIMIT_REQS=120
RATE_LIMIT_WINDOW=60

# Where the hash-chained explainability ledger is written. Must be a writable
# path; container images mount /app/data read-write and the rest read-only.
EXPLAIN_LEDGER_PATH=explainability_ledger.jsonl

# --- Alerts (Telegram) ---------------------------------------------------
# Outbound only: the process calls api.telegram.org, so nothing needs a public
# URL, a tunnel, or an open port. Leave blank and alerting is silently
# disabled -- the system behaves identically either way.
#
# Only events that happen unattended are sent: halt engaged, kill switch
# fired, drawdown breach, reconciliation mismatch, engine crash. Routine fills
# are not, or the channel becomes noise and stops being read.
#
# Get a token from @BotFather, then send your bot a message and read the
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum seconds between identical alerts. A guardrail tripping on every tick
# would otherwise send hundreds of messages a minute.
TELEGRAM_COOLDOWN_S=300

# --- Equity research data (Alpha Vantage) --------------------------------
# Used only by scripts/screen_equities.py and scripts/fetch_equity_bars.py.
# Nothing in the running service reads it, so leaving it blank is safe --
# those two scripts exit 1 with a message rather than failing part way.
#
# One key covers every equity need this project has: intraday bars by
# calendar month, LISTING_STATUS for the survivorship-free universe, and the
# fundamentals the Shariah worksheet screens on.
#
# The request budget depends on the account tier, so the scripts pace
# themselves with --sleep and cache aggressively rather than assuming a limit.
ALPHAVANTAGE_API_KEY=
# Twelve Data. Needed only for historical intraday bars, which are a
# premium endpoint on Alpha Vantage. Free tier: 8 req/min, 800/day.
TWELVEDATA_API_KEY=
# Alpaca market data. The free tier serves IEX only (~2.5% of US volume),
# which is shaped like consolidated bars and is not the market -- set
# ALPACA_FEED=iex only to confirm that, never to run a study on it.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=sip

# Webull OpenAPI. Also the intended execution venue, so its feed is the
# honest source for forward paper measurement even if another provider
# wins on history. WEBULL_BARS_PATH is unconfirmed from the public docs --
# set it from the API Reference; a 404 is a wrong path, not missing data.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_HOST=api.webull.com.my
WEBULL_BARS_PATH=/openapi/market-data/stock/bars
